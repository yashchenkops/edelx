---
import Header from '@/components/sections/Header/index.astro'
import Footer from '@/components/sections/Footer/index.astro'
import Preloader from '@/components/sections/Preloader/index.astro'
import SideNav from '@/components/layout/SideNav/index.astro'

import '@/styles/index.scss'

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Mozilla+Text:wght@200..700&display=swap" rel="stylesheet">
		<title>EDELX</title>
		
		<script is:inline>
			(() => {
				const themeKey = 'edelx-theme';
				const storedTheme = localStorage.getItem(themeKey);
				const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'dark';
				document.documentElement.setAttribute('data-theme', theme);

				const langKey = 'edelx-lang';
				const storedLang = localStorage.getItem(langKey);
				const lang = storedLang === 'fr' || storedLang === 'en' ? storedLang : 'en';
				document.documentElement.setAttribute('lang', lang);
			})();
		</script>
	</head>
	<body class="is-preloading">
		<Preloader />
		<Header />
		<SideNav />

		<main class="main">
			<slot />
		</main>
		
		<Footer />
	</body>
</html>

<style lang="scss">
	.main {
		margin-left: 200px;

		@media (max-width: 1024px) {
			margin-left: 0;
		}
	}
</style>