---
interface Props {
  as?: string;
  size?: string;
  tone?: string;
  class?: string;
}

const {
  as: Tag = 'h2',
  size = 'large',
  tone = 'dark',
  class: className = '',
  ...rest
} = Astro.props as Props;
---

<Tag
  class:list={[
    'section-title',
    `section-title--${size}`,
    `section-title--${tone}`,
    className
  ]}
  {...rest}
>
  <slot />
</Tag>

<style lang="scss">
  
</style>
