---
interface Props {
  as?: string;
  class?: string;
}

const {
  as: Tag = 'h2',
  class: className = '',
  ...rest
} = Astro.props as Props;
---

<Tag
  class:list={[
    'section-title',
    className
  ]}
  {...rest}
>
  <slot />
</Tag>

<style lang="scss">
  .section-title {
    position: relative;
    font-weight: 400;
    font-size: clamp(rem(60px), 8vw, rem(122px));
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text);

    &::before {
      content: '';
      position: absolute;
      top: -15px;
      left: -15px;
      width: 15px;
      height: 15px;
      background-color: transparent;
      border: 1px solid var(--color-text);
    }
  }
</style>
