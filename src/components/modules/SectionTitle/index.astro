---
interface Props {
  as?: string;
  class?: string;
}

const {
  as: Tag = 'h2',
  class: className = '',
  ...rest
} = Astro.props as Props;
---

<Tag
  class:list={[
    'section-title',
    className
  ]}
  {...rest}
>
  <span class="section-title__mark" aria-hidden="true"></span>
  <span class="section-title__label"><slot /></span>
</Tag>

<style lang="scss">
  .section-title {
    position: relative;
    font-weight: 400;
    font-size: clamp(rem(60px), 8vw, rem(122px));
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text);

    @media (max-width: 768px) {
      font-size: clamp(rem(36px), 11vw, rem(64px));
    }

    &__mark {
      position: absolute;
      top: -0.125em;
      left: -0.125em;
      width: 0.15em;
      height: 0.15em;
      border: 1px solid var(--color-text);
      background-color: transparent;
      pointer-events: none;
      transform-origin: center;
      will-change: transform, opacity;

      @media (max-width: 768px) {
        top: -0.1em;
        left: -0.1em;
        width: 0.125em;
        height: 0.125em;
      }
    }

    &__label {
      display: block;
    }

    :global(.word) {
      display: inline-block;
      overflow: clip;
      vertical-align: top;
    }

    :global(.line) {
      display: block;
      overflow: clip;
    }
  }
</style>
