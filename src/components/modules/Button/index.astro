---
const {
  as,
  href,
  type = 'button',
  variant = 'primary',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = as || (href ? 'a' : 'button');
---

<Tag
  class:list={[
    'button',
    `button--${variant}`,
    className
  ]}
  href={Tag === 'a' ? href : null}
  type={Tag === 'button' ? type : null}
  {...rest}
>
  <slot />
  <div class="button__arrow">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1.19995 18.2L18.2 1.19995M18.2 1.19995V18.2M18.2 1.19995H1.20144" stroke="#F8F8F8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</Tag>

<style lang="scss">
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 4px 4px 4px 30px;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-transform: capitalize;
    color: v.$black;
    transition: box-shadow 0.2s ease;
    max-width: 340px;

    &--primary {
      border: 1px solid v.$black;

      .button__arrow {
        background-color: v.$black;
      }
    }

    &--outline-white {
      border: 1px solid v.$white;
      background-color: v.$black;
      color: v.$white;

      .button__arrow {
        background-color: v.$white;

        svg {
          path {
            stroke: v.$black;
          }
        }
      }
    }

    &--blue {
      border: 1px solid v.$blue;
      background-color: v.$blue;
      color: v.$white;

      .button__arrow {
        background-color: v.$white;

        svg {
          path {
            stroke: v.$blue;
          }
        }
      }
    }

    &--white {
      border: 1px solid v.$white;
      background-color: v.$white;

      .button__arrow {
        background-color: v.$blue;

        svg {
          path {
            stroke: v.$white;
          }
        }
      }
    }

    &:hover {
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);

      .button__arrow {
        svg {
          translate: 3px -3px;
        }
      }
    }
  }

  .button__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    
    svg {
      transition: translate 0.2s ease;
    }
  }

  @media (max-width: v.$desktop-lg) {
    .button {
      font-size: 20px;
      padding-left: 15px;
    }

    .button__arrow {
      width: 42px;
      height: 42px;

      svg {
        width: 15px;
      }
    }
  }

  @media (max-width: v.$desktop) {
    .button {
      font-size: 16px;
      padding-left: 10px;
    }

    .button__arrow {
      width: 32px;
      height: 32px;

      svg {
        width: 10px;
      }
    }
  }

  @media (max-width: v.$tablet) {
    .button {
      font-size: 14px;
    }

    .button__arrow {
      width: 25px;
      height: 25px;

      svg {
        width: 8px;
      }
    }
  }

  @media (max-width: v.$mobile) {
    .button {
      font-size: 10px;
    }

    .button__arrow {
      width: 20px;
      height: 20px;

      svg {
        width: 6px;
      }
    }
  }
</style>
