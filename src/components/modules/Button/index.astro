---
const {
  as,
  href,
  type = 'button',
  variant = 'primary',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = as || (href ? 'a' : 'button');
const isGlass = variant === 'glass';
---

<Tag
  class:list={[
    'button',
    `button--${variant}`,
    className
  ]}
  href={Tag === 'a' ? href : null}
  type={Tag === 'button' ? type : null}
  {...rest}
>
  {isGlass && <span class="button__glow" aria-hidden="true"></span>}
  <span class="button__label"><slot /></span>
  <span class="button__arrow button__arrow--box" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1.19995 18.2L18.2 1.19995M18.2 1.19995V18.2M18.2 1.19995H1.20144" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class="button__arrow button__arrow--simple" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 14L14 2M14 2H6M14 2V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</Tag>

{isGlass && (
  <script>
    import '@/scripts/button-glass-glow.ts'
  </script>
)}

<style lang="scss">
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    max-width: 340px;
    padding: 4px 4px 4px 30px;
    border: 0;
    font-family: inherit;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-transform: capitalize;
    text-decoration: none;
    color: v.$black;
    cursor: pointer;
    transition: box-shadow 0.2s ease, opacity v.$transition-base, transform v.$transition-base;

    &--primary {
      border: 1px solid v.$black;
      background-color: transparent;

      .button__arrow {
        background-color: v.$black;
        color: v.$white;
      }
    }

    &--outline-white {
      border: 1px solid v.$white;
      background-color: v.$black;
      color: v.$white;

      .button__arrow {
        background-color: v.$white;
        color: v.$black;
      }
    }

    &--blue {
      border: 1px solid v.$blue;
      background-color: v.$blue;
      color: v.$white;

      .button__arrow {
        background-color: v.$white;
        color: v.$blue;
      }
    }

    &--white {
      border: 1px solid v.$white;
      background-color: v.$white;

      .button__arrow {
        background-color: v.$blue;
        color: v.$white;
      }
    }

    &--glass {
      justify-content: center;
      width: auto;
      max-width: none;
      padding: 41px 47px;
      border-radius: 999px;
      background: rgb(0 136 255 / 40%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: #fff;
      font-weight: 400;
      font-size: rem(20px);
      line-height: 0.9;
      text-transform: capitalize;
      gap: 14px;
      isolation: isolate;
      overflow: hidden;
      transition:
        background v.$transition-base,
        box-shadow v.$transition-base,
        transform v.$transition-base,
        opacity v.$transition-base;

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(
          145deg,
          rgb(255 255 255 / 75%) 0%,
          rgb(170 220 255 / 45%) 28%,
          rgb(0 136 255 / 25%) 58%,
          rgb(0 80 180 / 15%) 100%
        );
        transition: background v.$transition-base, opacity v.$transition-base;
        mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        mask-composite: exclude;
        -webkit-mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        pointer-events: none;
      }

      .button__glow {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: inherit;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(
          circle at var(--glow-x, 50%) var(--glow-y, 50%),
          rgb(255 255 255 / 50%) 0%,
          rgb(140 215 255 / 28%) 30%,
          transparent 68%
        );
        transform: scale(0.35);
        transition:
          opacity 0.35s ease,
          transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);

        &.is-active {
          opacity: 1;
          transform: scale(1.45);
          transition-duration: 0.1s, 0.5s;
        }

        &.is-fading {
          opacity: 0;
          transform: scale(1.45);
          transition: opacity 0.35s ease;
        }
      }

      .button__label,
      .button__arrow {
        position: relative;
        z-index: 1;
      }

      .button__arrow {
        width: auto;
        height: auto;
        background: transparent;
        color: inherit;

        &--box {
          display: none;
        }

        &--simple {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 16px;
          height: 16px;
          flex-shrink: 0;
        }

        &--simple svg {
          display: block;
          width: 16px;
          height: 16px;
          min-width: 16px;
          min-height: 16px;
        }
      }

      @include m.hover {
        background: rgb(0 136 255 / 58%);
        box-shadow:
          0 0 0 1px rgb(255 255 255 / 12%),
          0 8px 28px rgb(0 136 255 / 35%),
          0 2px 8px rgb(0 0 0 / 25%);
        transform: translateY(-2px);
        opacity: 1;

        &::before {
          background: linear-gradient(
            145deg,
            rgb(255 255 255 / 95%) 0%,
            rgb(190 230 255 / 70%) 30%,
            rgb(0 170 255 / 45%) 62%,
            rgb(0 100 200 / 25%) 100%
          );
        }

        .button__arrow svg {
          translate: 4px -4px;
        }
      }

      &:active {
        transform: scale(0.96) translateY(1px);
        background: rgb(0 136 255 / 68%);
        box-shadow:
          0 0 0 1px rgb(255 255 255 / 20%),
          0 2px 16px rgb(0 136 255 / 45%),
          inset 0 2px 12px rgb(255 255 255 / 18%);
        transition-duration: 0.08s;

        &::before {
          background: linear-gradient(
            145deg,
            rgb(255 255 255 / 100%) 0%,
            rgb(210 240 255 / 80%) 35%,
            rgb(0 180 255 / 55%) 68%,
            rgb(0 90 200 / 30%) 100%
          );
        }

        .button__arrow svg {
          translate: 6px -6px;
          transition-duration: 0.08s;
        }
      }
    }

    &:hover:not(.button--glass) {
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);

      .button__arrow {
        svg {
          translate: 3px -3px;
        }
      }
    }
  }

  .button__label {
    min-width: 0;
  }

  .button__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;

    &--simple {
      display: none;
    }

    svg {
      display: block;
      transition: translate 0.2s ease;
    }
  }

  @media (max-width: v.$desktop-lg) {
    .button:not(.button--glass) {
      font-size: 20px;
    }

    .button:not(.button--glass) .button__arrow {
      width: 42px;
      height: 42px;

      svg {
        width: 15px;
      }
    }
  }

  @media (max-width: v.$desktop) {
    .button:not(.button--glass) {
      font-size: 16px;
    }

    .button:not(.button--glass) .button__arrow {
      width: 32px;
      height: 32px;

      svg {
        width: 10px;
      }
    }
  }

  @media (max-width: v.$tablet) {
    .button:not(.button--glass) {
      font-size: 14px;
    }

    .button:not(.button--glass) .button__arrow {
      width: 25px;
      height: 25px;

      svg {
        width: 8px;
      }
    }
  }

  @media (max-width: v.$mobile) {
    .button:not(.button--glass) {
      font-size: 10px;
    }

    .button:not(.button--glass) .button__arrow {
      width: 20px;
      height: 20px;

      svg {
        width: 6px;
      }
    }
  }
</style>
