---
const menuItems = [
  { name: 'Main', slide: 'main' },
  { name: 'About Us', slide: 'about-us' },
  { name: 'Review', slide: 'review' },
  { name: 'FAQ', slide: 'faq' },
  { name: 'News', slide: 'news' },
  { name: 'Terms & Conditions', slide: 'terms-conditions' },
]
---

<!-- Burger button -->
<button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-burger>
  <span class="burger__icon" aria-hidden="true">
    <span class="burger__row burger__row--1">
      <span class="burger__dot"></span>
      <span class="burger__line"></span>
    </span>
    <span class="burger__row burger__row--2">
      <span class="burger__dot"></span>
      <span class="burger__line"></span>
    </span>
    <span class="burger__row burger__row--3">
      <span class="burger__dot"></span>
      <span class="burger__line"></span>
    </span>
  </span>
</button>

<!-- Mobile full-screen menu -->
<div class="mob-menu" data-mob-menu aria-hidden="true">
  <div class="mob-menu__panel">
    <div class="mob-menu__top">
      <a href={import.meta.env.BASE_URL} class="mob-menu__logo" data-mob-menu-close>
        <img class="mob-menu__logo-img mob-menu__logo-img--dark" src="src/assets/img/logo.webp" alt="EdelX">
        <img class="mob-menu__logo-img mob-menu__logo-img--light" src="src/assets/img/light/logo.webp" alt="EdelX">
      </a>

      <button class="mob-menu__close" type="button" aria-label="Close menu" data-mob-menu-close>
        <span class="mob-menu__close-line mob-menu__close-line--a" aria-hidden="true"></span>
        <span class="mob-menu__close-line mob-menu__close-line--b" aria-hidden="true"></span>
      </button>
    </div>

    <nav class="mob-menu__nav">
      <ul class="mob-menu__list">
        {menuItems.map((item, index) => (
          <li class="mob-menu__item" style={`--item-index: ${index};`}>
            <a
              href={`#${item.slide}`}
              class="mob-menu__link"
              data-nav-link={item.slide}
              data-mob-nav-link
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mob-menu__footer">
      <button
        type="button"
        class="mob-theme-toggle"
        data-theme-toggle
        aria-label="Toggle color theme"
      >
        <span class="mob-theme-toggle__label" data-theme-label>Dark</span>
        <span class="mob-theme-toggle__knob" aria-hidden="true" data-theme-knob></span>
      </button>

      <div class="mob-menu__actions">
        <a href="#" class="mob-menu__login">Log In</a>
        <span class="mob-menu__divider"></span>
        <a href="#" class="mob-menu__signup">Sign Up</a>
      </div>
    </div>
  </div>
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')
  const menu = document.querySelector<HTMLElement>('[data-mob-menu]')
  const closeBtns = document.querySelectorAll('[data-mob-menu-close]')

  // Escape transformed header ancestors so position:fixed covers the viewport.
  if (menu && menu.parentElement !== document.body) {
    document.body.appendChild(menu)
  }

  const open = () => {
    menu?.classList.add('is-open')
    menu?.removeAttribute('aria-hidden')
    burger?.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
  }

  const close = () => {
    menu?.classList.remove('is-open')
    menu?.setAttribute('aria-hidden', 'true')
    burger?.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
  }

  burger?.addEventListener('click', () => {
    if (!menu?.classList.contains('is-open')) open()
  })

  closeBtns.forEach((btn) => {
    btn.addEventListener('click', (event) => {
      if ((btn as HTMLElement).tagName === 'A') {
        event.preventDefault()
      }
      close()
    })
  })

  document.querySelectorAll('[data-mob-nav-link]').forEach((link) => {
    link.addEventListener('click', close)
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close()
  })
</script>

<style lang="scss">
  // ── Burger button ──────────────────────────────────────────────
  .burger {
    display: none;
    position: relative;
    z-index: calc(v.$z-header + 20);
    flex-direction: column;
    gap: 0;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    opacity: 0;

    @media (max-width: 1024px) {
      display: flex;
    }
  }

  .burger__icon {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .burger__row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .burger__dot {
    flex-shrink: 0;
    width: 4px;
    height: 4px;
    background: v.$blue;
  }

  .burger__line {
    width: 22px;
    height: 4px;
    background: #fff;

    :global([data-theme='light']) & {
      background: #111;
    }
  }

  // ── Full-screen mobile menu ────────────────────────────────────
  .mob-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    z-index: calc(v.$z-header + 50);
    pointer-events: none;

    @media (max-width: 1024px) {
      display: block;
    }

    &.is-open {
      pointer-events: auto;
    }
  }

  .mob-menu__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 64px;
    padding-inline: clamp(1rem, 2vw, 3rem);
    padding-bottom: clamp(rem(28px), 6vw, rem(48px));
    box-sizing: border-box;
    background-color: var(--color-bg);
    background-image: var(--bg-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 12px, 0) scale(0.985);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.45s;

    @media (max-width: 768px) {
      padding-top: 24px;
    }

    .mob-menu.is-open & {
      opacity: 1;
      visibility: visible;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  .mob-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: rem(16px);
    margin-bottom: clamp(rem(48px), 10vh, rem(88px));
  }

  .mob-menu__logo {
    display: block;
    max-width: rem(200px);

    @media (max-width: 768px) {
      max-width: rem(140px);
    }
  }

  .mob-menu__logo-img {
    display: block;
    width: 100%;
    height: auto;

    &--light {
      display: none;
    }
  }

  :global([data-theme='light']) {
    .mob-menu__logo-img--dark {
      display: none;
    }

    .mob-menu__logo-img--light {
      display: block;
    }
  }

  .mob-menu__close {
    position: relative;
    flex-shrink: 0;
    width: rem(40px);
    height: rem(40px);
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .mob-menu__close-line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: rem(28px);
    height: 4px;

    &--a {
      background: var(--color-text);
      transform: translate(-50%, -50%) rotate(45deg);
    }

    &--b {
      background: v.$blue;
      transform: translate(-50%, -50%) rotate(-45deg);
    }
  }

  .mob-menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
  }

  .mob-menu__list {
    display: flex;
    flex-direction: column;
    gap: clamp(rem(18px), 3.5vh, rem(32px));
    width: 100%;
  }

  .mob-menu__item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(0.08s + var(--item-index, 0) * 0.05s);

    .mob-menu.is-open & {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mob-menu__link {
    display: block;
    font-size: clamp(rem(28px), 8vw, rem(44px));
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-text);
    opacity: 0.45;
    transition: opacity 0.2s ease, transform 0.2s ease;

    &.is-active {
      opacity: 1;
      font-weight: 600;
      font-size: clamp(rem(40px), 11vw, rem(64px));
    }

    @include m.hover {
      opacity: 0.85;
      transform: translateX(6px);
    }
  }

  .mob-menu__footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: rem(16px);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: rem(32px);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.4s ease 0.2s,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;

    .mob-menu.is-open & {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mob-menu__actions {
    display: flex;
    align-items: center;
    gap: rem(18px);
    color: var(--color-text);

    a {
      font-size: rem(16px);
      transition: opacity 0.2s;

      @include m.hover {
        opacity: 0.7;
      }
    }
  }

  .mob-menu__login {
    order: 0;
  }

  .mob-menu__signup {
    opacity: 0.5;
    order: 2;
  }

  .mob-menu__divider {
    display: block;
    width: 2px;
    height: rem(24px);
    background: v.$blue;
    order: 1;
  }

  // ── Mobile theme toggle ────────────────────────────────────────
  .mob-theme-toggle {
    --theme-toggle-height: #{rem(36px)};
    --theme-toggle-knob: #{rem(28px)};
    --theme-toggle-pad: #{rem(4px)};

    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: rem(12px);
    min-width: rem(85px);
    height: var(--theme-toggle-height);
    padding-block: var(--theme-toggle-pad);
    padding-inline: rem(14px) var(--theme-toggle-pad);
    border: 1px solid var(--color-text);
    border-radius: rem(999px);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color v.$transition-base, color v.$transition-base, opacity v.$transition-base;

    &[data-theme-state='light'] {
      flex-direction: row-reverse;
      padding-inline: var(--theme-toggle-pad) rem(14px);
    }

    &__label {
      font-size: rem(14px);
      font-weight: 500;
      line-height: 1;
      user-select: none;
    }

    &__knob {
      flex-shrink: 0;
      width: var(--theme-toggle-knob);
      height: var(--theme-toggle-knob);
      border-radius: v.$radius-round;
      background-color: var(--color-text);
      transition: background-color v.$transition-base;
    }

    @include m.hover {
      opacity: 0.8;
    }
  }
</style>
