---
const menuItems = [
  { name: 'Main', slide: 'main' },
  { name: 'About Us', slide: 'about-us' },
  { name: 'Review', slide: 'review' },
  { name: 'FAQ', slide: 'faq' },
  { name: 'News', slide: 'news' },
  { name: 'Terms&Conditions', slide: 'terms-conditions' },
];
---

<nav class="side-nav" aria-label="Page sections" data-side-nav>
  <ul class="side-nav__list">
    {
      menuItems.map((item) => (
        <li class="side-nav__item">
          <a
            href={`#${item.slide}`}
            class="side-nav__link"
            data-nav-link={item.slide}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { gsap } from 'gsap'
  import { runWhenAppReady } from '@/scripts/app-ready'

  const nav = document.querySelector<HTMLElement>('[data-side-nav]')
  const items = Array.from(document.querySelectorAll<HTMLElement>('.side-nav__item'))

  if (nav && items.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    gsap.set(items, {
      opacity: 0,
      x: -18,
    })

    runWhenAppReady(() => {
      if (reduced) {
        gsap.to(items, { opacity: 1, x: 0, duration: 0.2, overwrite: true })
        return
      }

      gsap.fromTo(
        items,
        { opacity: 0, x: -18 },
        {
          opacity: 1,
          x: 0,
          duration: 0.5,
          delay: 0.08,
          stagger: 0.05,
          ease: 'power3.out',
          overwrite: true,
        },
      )
    })
  }
</script>

<style lang="scss">
  .side-nav {
    position: fixed;
    top: 50%;
    left: clamp(1rem, 2vw, 3rem);
    z-index: v.$z-header;
    transform: translateY(-50%);

    @media (max-width: 1024px) {
      display: none;
    }

    &__list {
      display: flex;
      flex-direction: column;
      gap: rem(18px);
    }

    &__item {
      opacity: 0;
    }

    &__link {
      display: block;
      font-size: rem(14px);
      line-height: 1.2;
      color: var(--color-text);
      opacity: 0.45;
      transition: opacity v.$transition-base, transform v.$transition-base;
      transform: scale(1);

      &.is-active {
        opacity: 1;
        font-weight: 600;
        transform: scale(1.08);
      }

      @include m.hover {
        opacity: 0.85;
        transform: scale(1.05)
      }
    }
  }
</style>
