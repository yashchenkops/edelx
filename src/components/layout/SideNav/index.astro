---
const menuItems = [
  { name: 'Main', slide: 'main' },
  { name: 'About Us', slide: 'about-us' },
  { name: 'Review', slide: 'review' },
  { name: 'FAQ', slide: 'faq' },
  { name: 'News', slide: 'news' },
  { name: 'Terms&Conditions', slide: 'terms-conditions' },
];
---

<nav class="side-nav" aria-label="Page sections">
  <ul class="side-nav__list">
    {
      menuItems.map((item) => (
        <li class="side-nav__item">
          <a
            href={`#${item.slide}`}
            class="side-nav__link"
            data-nav-link={item.slide}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  .side-nav {
    position: fixed;
    top: 50%;
    left: clamp(#{rem(16px)}, 3vw, #{rem(48px)});
    z-index: v.$z-header;
    transform: translateY(-50%);

    &__list {
      display: flex;
      flex-direction: column;
      gap: rem(18px);
    }

    &__link {
      display: block;
      font-size: rem(14px);
      line-height: 1.2;
      color: var(--color-text);
      opacity: 0.45;
      transition: opacity v.$transition-base, transform v.$transition-base;
      transform: scale(1);

      &.is-active {
        opacity: 1;
        font-weight: 600;
        transform: scale(1.08);
      }

      @include m.hover {
        opacity: 0.85;
        transform: scale(1.05)
      }
    }
  }
</style>
