---
interface Props {
  class?: string;
  slide?: string;
}

const { class: sectionClass = '', slide, ...rest } = Astro.props as Props;
const slideId = slide ?? sectionClass;
---

<section
  class:list={['page-section', 'swiper-slide', sectionClass && `page-section--${sectionClass}`]}
  data-slide={slideId || undefined}
  data-hash={slideId || undefined}
  {...rest}
>
  <div class="page-section__scene">
    <div class="page-section__decor" aria-hidden="true"></div>
    <div class="page-section__inner">
      <slot />
    </div>
  </div>
</section>

<style lang="scss">
  $page-width: 1792px;
  $page-padding-min: 30px;
  $page-padding-max: 65px;

  .page-section {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .page-section__scene {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    box-sizing: border-box;

    @media (max-width: 1024px) {
      /* Clear fixed header; keep content vertically centered in remaining space */
      padding-top: rem(152px);
      padding-bottom: rem(72px);
    }

    @media (max-width: 768px) {
      padding-top: rem(120px);
      padding-bottom: rem(48px);
    }
  }

  .page-section__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-section__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * clamp($page-padding-min, 3vw, $page-padding-max), $page-width);
    margin-inline: auto;
    transform-origin: center center;
    will-change: transform;

    @media (max-width: 768px) {
      width: min(100% - 2 * clamp(15px, 4vw, 30px), $page-width);
    }
  }

  .page-section__inner :global(.section-title) {
    will-change: transform, opacity;
  }
</style>
