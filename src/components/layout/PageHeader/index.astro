---
const { class: sectionClass = '', ...rest } = Astro.props;
---

<header class:list={['page-header', sectionClass && `page-header--${sectionClass}`]} {...rest}>
  <div class="page-header__inner">
    <slot />
  </div>
</header>

<style lang="scss">
  $page-width: 100%;
  $page-padding-min: 30px;
  $page-padding-max: 65px;

  .page-header {
    position: fixed;
    top: 64px;
    left: 0;
    width: 100%;
    z-index: v.$z-header;
  }

  .page-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(
      calc(100% - 2 * clamp(#{$page-padding-min}, 3vw, #{$page-padding-max})),
      $page-width
    );
    margin-inline: auto;
  }
</style>
