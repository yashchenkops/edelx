---
const { class: sectionClass = '', ...rest } = Astro.props;
---

<header class:list={['page-header', sectionClass && `page-header--${sectionClass}`]} {...rest}>
  <div class="page-header__inner">
    <slot />
  </div>
</header>

<style lang="scss">
  .page-header {
    position: fixed;
    top: 64px;
    left: 0;
    width: 100%;
    z-index: v.$z-header;
    padding-inline: clamp(1rem, 2vw, 3rem);
    box-sizing: border-box;

    @media (max-width: 768px) {
      top: 24px;
    }
  }

  .page-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
</style>
