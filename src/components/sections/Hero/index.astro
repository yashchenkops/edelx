---
import Section from '@/components/layout/Section/index.astro';
import SectionTitle from '@/components/modules/SectionTitle/index.astro';
---

<Section class="hero" slide="main">
  <div class="hero__inner">
    <div class="hero__title">
      <SectionTitle>NEW WAY FOR FINANCE</SectionTitle>
    </div>

    <div class="hero__illustration">
      <svg class="hero__shape" width="829" height="509" viewBox="0 0 829 509" fill="none" xmlns="http://www.w3.org/2000/svg">
        <filter id="displacementFilter">
          <feImage
            href="data:image/png;base64,"
            preserveAspectRatio="none"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="turbulence"
            scale="600"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
        <defs>
          <linearGradient id="hero-border" x1="414.5" y1="0" x2="414.5" y2="509" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#fff" stop-opacity="0.04" />
            <stop offset="30%" stop-color="#fff" stop-opacity="0.14" />
            <stop offset="65%" stop-color="#fff" stop-opacity="0.38" />
            <stop offset="100%" stop-color="#fff" stop-opacity="0.72" />
          </linearGradient>
          <linearGradient id="hero-edge-highlight" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#fff" stop-opacity="0" />
            <stop offset="18%" stop-color="#fff" stop-opacity="0.42" />
            <stop offset="82%" stop-color="#fff" stop-opacity="0.42" />
            <stop offset="100%" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <filter id="hero-border-glow" x="-8%" y="-8%" width="116%" height="116%" color-interpolation-filters="sRGB">
            <feGaussianBlur in="SourceGraphic" stdDeviation="0.6" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <g class="hero__shape-fill">
          <path d="M595.973 0C595.32 5.70682e-08 594.716 0.344247 594.382 0.905378L464.236 219.941C461.569 224.43 456.734 227.181 451.514 227.181H443.799C435.626 227.181 429 233.809 429 241.985V267.015C429 275.191 435.626 281.819 443.799 281.819H451.514C456.734 281.819 461.569 284.57 464.236 289.059L594.381 508.095C594.714 508.656 595.319 509 595.971 509H828.071C828.797 509 829.24 508.202 828.856 507.585L687.945 281.558C686.932 279.932 685.152 278.943 683.236 278.943H505.667C497.493 278.943 490.867 272.314 490.868 264.138L490.868 244.86C490.869 236.684 497.495 230.057 505.668 230.057H683.238C685.153 230.057 686.934 229.068 687.947 227.442L828.859 1.41459C829.242 0.79834 828.799 -6.34854e-08 828.073 0H595.973Z" fill="#121212" fill-opacity="0.85"/>
          <path d="M233.027 0C233.68 5.70682e-08 234.284 0.344247 234.618 0.905378L364.764 219.941C367.431 224.43 372.266 227.181 377.486 227.181H385.201C393.374 227.181 400 233.809 400 241.985V267.015C400 275.191 393.374 281.819 385.201 281.819H377.486C372.266 281.819 367.431 284.57 364.764 289.059L234.619 508.095C234.286 508.656 233.681 509 233.029 509H0.928623C0.202569 509 -0.240035 508.202 0.144059 507.585L141.055 281.558C142.068 279.932 143.848 278.943 145.764 278.943H323.333C331.507 278.943 338.133 272.314 338.132 264.138L338.132 244.86C338.131 236.684 331.505 230.057 323.332 230.057H145.762C143.847 230.057 142.066 229.068 141.053 227.442L0.141257 1.41459C-0.242478 0.79834 0.200829 -6.34854e-08 0.926755 0H233.027Z" fill="#121212" fill-opacity="0.85"/>
        </g>

        <g class="hero__shape-border" filter="url(#hero-border-glow)">
          <path d="M595.973 0C595.32 5.70682e-08 594.716 0.344247 594.382 0.905378L464.236 219.941C461.569 224.43 456.734 227.181 451.514 227.181H443.799C435.626 227.181 429 233.809 429 241.985V267.015C429 275.191 435.626 281.819 443.799 281.819H451.514C456.734 281.819 461.569 284.57 464.236 289.059L594.381 508.095C594.714 508.656 595.319 509 595.971 509H828.071C828.797 509 829.24 508.202 828.856 507.585L687.945 281.558C686.932 279.932 685.152 278.943 683.236 278.943H505.667C497.493 278.943 490.867 272.314 490.868 264.138L490.868 244.86C490.869 236.684 497.495 230.057 505.668 230.057H683.238C685.153 230.057 686.934 229.068 687.947 227.442L828.859 1.41459C829.242 0.79834 828.799 -6.34854e-08 828.073 0H595.973Z" fill="none" stroke="url(#hero-border)" stroke-width="0.50" vector-effect="non-scaling-stroke"/>
          <path d="M233.027 0C233.68 5.70682e-08 234.284 0.344247 234.618 0.905378L364.764 219.941C367.431 224.43 372.266 227.181 377.486 227.181H385.201C393.374 227.181 400 233.809 400 241.985V267.015C400 275.191 393.374 281.819 385.201 281.819H377.486C372.266 281.819 367.431 284.57 364.764 289.059L234.619 508.095C234.286 508.656 233.681 509 233.029 509H0.928623C0.202569 509 -0.240035 508.202 0.144059 507.585L141.055 281.558C142.068 279.932 143.848 278.943 145.764 278.943H323.333C331.507 278.943 338.133 272.314 338.132 264.138L338.132 244.86C338.131 236.684 331.505 230.057 323.332 230.057H145.762C143.847 230.057 142.066 229.068 141.053 227.442L0.141257 1.41459C-0.242478 0.79834 0.200829 -6.34854e-08 0.926755 0H233.027Z" fill="none" stroke="url(#hero-border)" stroke-width="0.50" vector-effect="non-scaling-stroke"/>
        </g>

        <g class="hero__shape-edges" stroke="url(#hero-edge-highlight)" stroke-width="0.9" stroke-linecap="round">
          <line x1="12" y1="0.45" x2="222" y2="0.45" />
          <line x1="607" y1="0.45" x2="817" y2="0.45" />
          <line x1="155" y1="230.057" x2="314" y2="230.057" />
          <line x1="515" y1="230.057" x2="674" y2="230.057" />
        </g>
      </svg>
    </div>
  </div>
</Section>

<style lang="scss">
  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vw, 120px);
  }

  .hero__title {
    max-width: 666px;
  }

  .hero__illustration {
    position: relative;
    flex-shrink: 0;
  }

  .hero__shape {
    overflow: visible;

    path {
      fill: rgba(255, 255, 255, 0.03);
    }
  }

</style>
