---
import Section from '@/components/layout/Section/index.astro';
import SectionTitle from '@/components/modules/SectionTitle/index.astro';
import SectionSubtitle from '@/components/modules/SectionSubtitle/index.astro';
import Button from '@/components/modules/Button/index.astro';

const articles = [
  {
    title: 'What’s new at finance world?',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  },
  {
    title: 'Which currency is the most profitable at the moment?',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  },
  {
    title: 'Hello! Its you’re new finance agent.',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  }
];
---

<Section class="news" slide="news">
  <div class="news__inner">
    <div class="news__content">
      <SectionTitle>News</SectionTitle>
      <SectionSubtitle>Still not convinced? Here's what reputable market partners say.</SectionSubtitle>
    </div>
    <div class="news__articles">
      {articles.map((article, index) => {
        return (
          <article class="news__article" style={`--item-index: ${index};`}>
            <div class="news__article-info">
              <h3 class="news__article-title">
                {article.title}
              </h3>
              <p class="news__article-description">
                {article.description}
              </p>
            </div>
            <div class="news__article-button">
              <Button href={article.href} variant="glass">{article.button}</Button>
            </div>
          </article>
        )
      })}
    </div>
    <div class="news__decoration news__decoration--edit-machine">
      <img src="src/assets/img/news-edit-machine.webp" alt="Text machine">
    </div>
    <div class="news__decoration news__decoration--hashtag">
      <img src="src/assets/img/news-hashtag.webp" alt="Hashtag">
    </div>
  </div>
</Section>

<script>
  import { gsap } from 'gsap'

  const slide = document.querySelector<HTMLElement>('[data-slide="news"]')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.news__article'))

  if (slide && cards.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let played = false
    let isActive = slide.classList.contains('swiper-slide-active')

    gsap.set(cards, {
      opacity: 0,
      y: 36,
      filter: 'blur(8px)',
    })

    const playIn = () => {
      if (reduced) {
        gsap.to(cards, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.25, overwrite: true })
        return
      }

      gsap.fromTo(
        cards,
        { opacity: 0, y: 36, filter: 'blur(8px)' },
        {
          opacity: 1,
          y: 0,
          filter: 'blur(0px)',
          duration: 0.7,
          delay: 0.18,
          stagger: 0.1,
          ease: 'power3.out',
          overwrite: true,
        },
      )
      played = true
    }

    const playOut = () => {
      if (!played) return
      gsap.to(cards, {
        opacity: 0,
        y: -16,
        filter: 'blur(6px)',
        duration: reduced ? 0.2 : 0.28,
        stagger: 0.04,
        ease: 'power2.in',
        overwrite: true,
      })
    }

    const sync = () => {
      const nextActive = slide.classList.contains('swiper-slide-active')
      if (nextActive === isActive) return
      isActive = nextActive
      if (nextActive) playIn()
      else playOut()
    }

    new MutationObserver(sync).observe(slide, {
      attributes: true,
      attributeFilter: ['class'],
    })

    if (isActive) playIn()
  }
</script>

<style lang="scss">
  .news__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    @media (max-width: 1200px) {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(rem(32px), 5vw, rem(56px));
    }
  }

  .news__content {
    flex: 0 1 666px;
    max-width: 666px;
    min-width: 0;

    @media (max-width: 1200px) {
      flex: none;
      max-width: 100%;
    }
  }

  .news__title {
    max-width: 666px;
    margin-bottom: 30px;
  }

  .news__articles {
    max-width: 711px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 26px;

    @media (max-width: 1200px) {
      max-width: 100%;
    }

    @media (max-width: 768px) {
      gap: 16px;
    }
  }

  .news__article {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 35px 40px;
    border-radius: 20px;
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 8px 28px rgb(0 0 0 / 18%);
    isolation: isolate;

    @media (min-width: 1201px) {
      padding-right: 180px;
    }

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 24px 24px 28px;
    }

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(
        180deg,
        rgb(255 255 255 / 45%) 0%,
        rgb(255 255 255 / 15%) 35%,
        rgb(255 255 255 / 0%) 100%
      );
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      pointer-events: none;
    }

    &-info {
      max-width: 420px;
      position: relative;
      z-index: 1;

      @media (max-width: 768px) {
        max-width: 100%;
      }
    }

    &-button {
      display: inline-block;
      position: absolute;
      top: 50%;
      right: -35px;
      transform: translateY(-50%);
      z-index: 1;
      flex-shrink: 0;

      @media (max-width: 1200px) {
        position: static;
        top: auto;
        right: auto;
        transform: none;
        flex-shrink: 0;
      }

      :global(.button--glass) {
        padding: 30px 35px;
        background: #0d62b8;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;

        @media (max-width: 768px) {
          padding: 20px 28px;
          font-size: rem(14px);
        }

        &:hover {
          background: #1270cc;
        }

        &:active {
          background: #0a56a0;
        }
      }
    }
  }

  :global([data-theme='light']) .news__article {
    background: rgb(0 0 0 / 10%);
    box-shadow: 0 8px 28px rgb(0 0 0 / 8%);

    &::before {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 18%) 0%,
        rgb(0 0 0 / 8%) 35%,
        rgb(0 0 0 / 0%) 100%
      );
    }
  }

  .news__decoration {
    position: absolute;
    user-select: none;
    pointer-events: none;

    &--edit-machine {
      bottom: -200px;
      left: 40%;
      transform: translateX(-50%);
      max-width: 245px;
      z-index: 1;

      @media (max-width: 1200px) {
        bottom: -100px;
        left: 50%;
        top: auto;
        right: auto;
        transform: translateX(-50%);
        max-width: 160px;
        opacity: 0.7;
      }

      @media (max-width: 768px) {
        max-width: 120px;
        bottom: -70px;
        opacity: 0.55;
      }
    }

    &--hashtag {
      top: -110px;
      right: 330px;
      max-width: 145px;
      z-index: -1;

      @media (max-width: 1200px) {
        top: -70px;
        right: 80px;
        left: auto;
        max-width: 100px;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        max-width: 70px;
        top: -45px;
        right: 40px;
        opacity: 0.4;
      }
    }
  }
</style>
