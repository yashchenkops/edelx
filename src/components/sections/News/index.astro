---
import Section from '@/components/layout/Section/index.astro';
import SectionTitle from '@/components/modules/SectionTitle/index.astro';
import SectionSubtitle from '@/components/modules/SectionSubtitle/index.astro';
import Button from '@/components/modules/Button/index.astro';

const articles = [
  {
    title: 'What’s new at finance world?',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  },
  {
    title: 'Which currency is the most profitable at the moment?',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  },
  {
    title: 'Hello! Its you’re new finance agent.',
    description: 'Still not convinced? Here\'s what reputable market partners say. Some people say thats in not possible, but we don’t agree...',
    button: 'Read more',
    href: '#',
  }
];
---

<Section class="news" slide="news" data-fit="scroll">
  <div class="news__inner">
    <div class="news__content">
      <SectionTitle>News</SectionTitle>
      <SectionSubtitle>Still not convinced? Here's what reputable market partners say.</SectionSubtitle>
    </div>
    <div class="news__articles">
      {articles.map((article, index) => {
        return (
          <article class="news__article" style={`--item-index: ${index};`}>
            <div class="news__article-info">
              <h3 class="news__article-title">
                {article.title}
              </h3>
              <p class="news__article-description">
                {article.description}
              </p>
            </div>
            <div class="news__article-button">
              <Button href={article.href} variant="glass">{article.button}</Button>
            </div>
          </article>
        )
      })}
    </div>
    <div class="news__decoration news__decoration--edit-machine">
      <div class="news__decoration-reveal">
        <img src="src/assets/img/news-edit-machine.webp" alt="Text machine">
      </div>
    </div>
    <div class="news__decoration news__decoration--hashtag">
      <div class="news__decoration-reveal">
        <img src="src/assets/img/news-hashtag.webp" alt="Hashtag">
      </div>
    </div>
  </div>
</Section>

<script>
  import { gsap } from 'gsap'
  import { runWhenAppReady } from '@/scripts/app-ready'

  const slide = document.querySelector<HTMLElement>('[data-slide="news"]')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.news__article'))
  const decorations = Array.from(
    document.querySelectorAll<HTMLElement>('.news__decoration-reveal'),
  )

  if (slide) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let played = false
    let isActive = slide.classList.contains('swiper-slide-active')

    if (cards.length) {
      gsap.set(cards, {
        opacity: 0,
        y: 36,
      })
    }

    if (decorations.length) {
      gsap.set(decorations, {
        opacity: 0,
        y: 28,
        scale: 0.94,
        filter: 'blur(10px)',
      })
    }

    const playIn = () => {
      runWhenAppReady(() => {
        if (!slide.classList.contains('swiper-slide-active')) return

        if (reduced) {
          if (cards.length) {
            gsap.to(cards, {
              opacity: 1,
              y: 0,
              duration: 0.25,
              overwrite: true,
              onComplete: () => gsap.set(cards, { clearProps: 'transform' }),
            })
          }
          if (decorations.length) {
            gsap.to(decorations, {
              opacity: 1,
              y: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.25,
              overwrite: true,
            })
          }
          played = true
          return
        }

        if (cards.length) {
          gsap.fromTo(
            cards,
            { opacity: 0, y: 36 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              delay: 0.06,
              stagger: 0.1,
              ease: 'power3.out',
              overwrite: true,
              onComplete: () => gsap.set(cards, { clearProps: 'transform' }),
            },
          )
        }

        if (decorations.length) {
          gsap.fromTo(
            decorations,
            {
              opacity: 0,
              y: 28,
              scale: 0.94,
              filter: 'blur(10px)',
            },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.85,
              delay: 0.2,
              stagger: 0.14,
              ease: 'power3.out',
              overwrite: true,
            },
          )
        }

        played = true
      })
    }

    const playOut = () => {
      if (!played) return

      if (cards.length) {
        gsap.to(cards, {
          opacity: 0,
          y: -16,
          duration: reduced ? 0.2 : 0.28,
          stagger: 0.04,
          ease: 'power2.in',
          overwrite: true,
        })
      }

      if (decorations.length) {
        gsap.to(decorations, {
          opacity: 0,
          y: -14,
          scale: 0.97,
          filter: 'blur(6px)',
          duration: reduced ? 0.2 : 0.28,
          stagger: 0.05,
          ease: 'power2.in',
          overwrite: true,
        })
      }
    }

    // ── Mouse parallax on decorations (desktop only) ───────────────
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    const desktopMq = window.matchMedia('(min-width: 1024px)')
    const decorationLayers = Array.from(
      document.querySelectorAll<HTMLElement>('.news__decoration'),
    )

    const parallaxEnabled = () =>
      !reduced && finePointer.matches && desktopMq.matches && decorationLayers.length > 0

    const parallaxProxies = decorationLayers.map((el, index) => {
      const proxy = { x: 0, y: 0 }
      const max = index === 0 ? 22 : 14
      const apply = () => {
        el.style.setProperty('--parallax-x', `${proxy.x}px`)
        el.style.setProperty('--parallax-y', `${proxy.y}px`)
      }
      apply()
      return { el, proxy, max, apply }
    })

    const resetParallax = () => {
      parallaxProxies.forEach(({ proxy, apply }) => {
        gsap.to(proxy, {
          x: 0,
          y: 0,
          duration: 0.55,
          ease: 'power3.out',
          overwrite: true,
          onUpdate: apply,
        })
      })
    }

    const onPointerMove = (event: PointerEvent) => {
      if (!parallaxEnabled() || !isActive) return

      const rect = slide.getBoundingClientRect()
      if (!rect.width || !rect.height) return

      const nx = ((event.clientX - rect.left) / rect.width - 0.5) * 2
      const ny = ((event.clientY - rect.top) / rect.height - 0.5) * 2
      const clampedX = Math.max(-1, Math.min(1, nx))
      const clampedY = Math.max(-1, Math.min(1, ny))

      parallaxProxies.forEach(({ proxy, max, apply }) => {
        gsap.to(proxy, {
          x: clampedX * max,
          y: clampedY * max,
          duration: 0.7,
          ease: 'power3.out',
          overwrite: true,
          onUpdate: apply,
        })
      })
    }

    if (decorationLayers.length && !reduced) {
      window.addEventListener('pointermove', onPointerMove)
      desktopMq.addEventListener('change', () => {
        if (!desktopMq.matches) resetParallax()
      })
    }

    const scene = slide.querySelector<HTMLElement>('.page-section__scene')

    const sync = () => {
      const nextActive = slide.classList.contains('swiper-slide-active')
      if (nextActive === isActive) return
      isActive = nextActive
      if (nextActive) {
        if (scene) scene.scrollTop = 0
        playIn()
      } else {
        playOut()
        resetParallax()
      }
    }

    new MutationObserver(sync).observe(slide, {
      attributes: true,
      attributeFilter: ['class'],
    })

    if (isActive) playIn()
  }
</script>

<style lang="scss">
  :global(.page-section--news) {
    overflow: hidden;
  }

  :global(.page-section--news .page-section__scene) {
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    align-items: flex-start;
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;

    &::-webkit-scrollbar {
      width: 0;
      height: 0;
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background: transparent;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }
  }

  :global(.page-section--news .page-section__inner) {
    margin-block: auto;
    transform: none !important;
  }

  .news__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    @media (max-width: 1200px) {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(rem(24px), 3.5vh, rem(48px));
      width: 100%;
    }
  }

  .news__content {
    flex: 0 1 666px;
    max-width: 666px;
    min-width: 0;

    @media (max-width: 1200px) {
      flex: none;
      max-width: 100%;
    }
  }

  .section-title {
    max-width: 666px;
    margin-bottom: clamp(rem(12px), 2.2vh, rem(30px));
  }

  .news__articles {
    max-width: 711px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(rem(16px), 2.2vh, rem(26px));

    @media (max-width: 1200px) {
      max-width: 100%;
    }
  }

  .news__article {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(rem(22px), 2.8vh, rem(35px)) clamp(rem(24px), 3vw, rem(40px));
    border-radius: 20px;
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 8px 28px rgb(0 0 0 / 18%);

    @media (min-width: 1201px) {
      padding-right: 180px;
    }

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: flex-start;
      gap: rem(16px);
      padding: rem(22px) rem(20px) rem(24px);
    }

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(
        180deg,
        rgb(255 255 255 / 45%) 0%,
        rgb(255 255 255 / 15%) 35%,
        rgb(255 255 255 / 0%) 100%
      );
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      pointer-events: none;
    }

    &-info {
      max-width: 420px;
      position: relative;
      z-index: 1;

      @media (max-width: 768px) {
        max-width: 100%;
      }
    }

    &-title {
      margin-bottom: 6px;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }

    &-description {
      margin: 0;
      font-weight: 200;
      font-size: clamp(rem(12px), 1.1vw, rem(16px));
      line-height: 1.45;
      color: var(--color-text);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
      mask-image: linear-gradient(
        180deg,
        #000 0%,
        #000 32%,
        rgb(0 0 0 / 55%) 62%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        180deg,
        #000 0%,
        #000 32%,
        rgb(0 0 0 / 55%) 62%,
        transparent 100%
      );
    }

    &-button {
      display: inline-block;
      position: absolute;
      top: 50%;
      right: -35px;
      transform: translateY(-50%);
      z-index: 1;
      flex-shrink: 0;

      @media (max-width: 1200px) {
        position: static;
        top: auto;
        right: auto;
        transform: none;
        flex-shrink: 0;
      }

      :global(.button--glass) {
        padding: 30px 35px;
        background: #0d62b8;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;

        @media (max-width: 768px) {
          padding: 20px 28px;
          font-size: rem(14px);
        }

        &:hover {
          background: #1270cc;
        }

        &:active {
          background: #0a56a0;
        }
      }
    }
  }

  :global([data-theme='light']) .news__article {
    background: rgb(0 0 0 / 10%);
    box-shadow: 0 8px 28px rgb(0 0 0 / 8%);

    &::before {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 18%) 0%,
        rgb(0 0 0 / 8%) 35%,
        rgb(0 0 0 / 0%) 100%
      );
    }
  }

  .news__decoration {
    --parallax-x: 0px;
    --parallax-y: 0px;
    position: absolute;
    user-select: none;
    pointer-events: none;
    translate: var(--parallax-x) var(--parallax-y);

    &-reveal {
      opacity: 0;

      img {
        display: block;
        width: 100%;
        height: auto;
      }
    }

    &--edit-machine {
      bottom: -200px;
      left: 40%;
      translate: calc(-50% + var(--parallax-x)) var(--parallax-y);
      max-width: 245px;
      z-index: 1;

      @media (max-width: 1200px) {
        bottom: -100px;
        left: 50%;
        top: auto;
        right: auto;
        max-width: 160px;
        opacity: 0.7;
      }

      @media (max-width: 768px) {
        max-width: 120px;
        bottom: -70px;
        opacity: 0.55;
      }
    }

    &--hashtag {
      top: -110px;
      right: 330px;
      max-width: 145px;
      z-index: -1;

      @media (max-width: 1200px) {
        top: -70px;
        right: 80px;
        left: auto;
        max-width: 100px;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        max-width: 70px;
        top: -45px;
        right: 40px;
        opacity: 0.4;
      }
    }
  }
</style>
