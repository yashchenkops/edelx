---
import Section from '@/components/layout/Section/index.astro';
import SectionTitle from '@/components/modules/SectionTitle/index.astro';
import { documents } from './content';
---

<Section class="terms-and-conditions" slide="terms-conditions">
  <div class="terms-and-conditions__inner">
    <div class="terms-and-conditions__content">
      <div class="terms-titles swiper" data-terms-titles aria-label="Legal documents">
        <div class="swiper-wrapper">
          {documents.map((doc) => (
            <div class="swiper-slide terms-titles__slide">
              <SectionTitle>{doc.title}</SectionTitle>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="terms-and-conditions__scroll-wrap" data-nested-local-scroll>
      {documents.map((doc, index) => (
        <div
          class="terms-and-conditions__list"
          data-terms-panel
          hidden={index !== 0}
        >
          {doc.blocks.map((block) => {
            if (block.type === 'title') {
              return <p class="terms-and-conditions__list-title">{block.text}</p>
            }
            if (block.type === 'subtitle') {
              return <p class="terms-and-conditions__list-subtitle">{block.text}</p>
            }
            if (block.type === 'definition') {
              return (
                <p class="terms-and-conditions__list-definition">
                  <strong>“{block.term}”</strong> {block.text}
                </p>
              )
            }
            if (block.type === 'list') {
              return (
                <ul
                  class:list={[
                    'terms-and-conditions__list-ul',
                    { 'terms-and-conditions__list-ul--nested': block.nested },
                  ]}
                >
                  {block.items.map((item) => <li>{item}</li>)}
                </ul>
              )
            }
            return <p class="terms-and-conditions__list-text">{block.text}</p>
          })}
        </div>
      ))}
    </div>
  </div>
</Section>

<script>
  import '@/scripts/terms-slider.ts'
</script>

<style lang="scss">
  :global(.page-section--terms-and-conditions .page-section__scene) {
    @media (max-width: 1024px) {
      align-items: flex-start;
      padding-top: rem(112px);
      padding-bottom: rem(24px);
    }

    @media (max-width: 768px) {
      padding-top: rem(84px);
      padding-bottom: rem(16px);
    }
  }

  .terms-and-conditions__inner {
    --footer-offset: #{rem(240px)};
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(rem(16px), 2vw, rem(32px));

    @media (max-width: 1024px) {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: rem(12px);
      padding-bottom: var(--footer-offset, rem(260px));
      box-sizing: border-box;
      min-height: 0;
      width: 100%;
    }

    @media (max-width: 768px) {
      padding-bottom: var(--footer-offset, rem(280px));
      gap: rem(10px);
    }
  }

  .terms-and-conditions__content {
    flex: 1 1 52%;
    max-width: 54%;
    min-width: 0;

    @media (max-width: 1024px) {
      flex: none;
      max-width: 100%;
      width: 100%;
    }
  }

  .terms-titles {
    overflow: hidden;
    height: clamp(rem(320px), 58vh, rem(640px));
    padding: rem(28px) rem(8px) rem(28px) rem(24px);
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
    user-select: none;

    @media (max-width: 1024px) {
      width: 100%;
      height: auto;
      overflow: hidden;
      padding: 0;
      mask-image: linear-gradient(
        90deg,
        #000 0%,
        #000 78%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        90deg,
        #000 0%,
        #000 78%,
        transparent 100%
      );
    }
  }

  .terms-titles :global(.swiper-wrapper) {
    height: 100%;
    align-items: center;

    @media (max-width: 1024px) {
      height: auto;
      align-items: flex-start;
      justify-content: flex-start;
    }
  }

  .terms-titles :global(.swiper-slide) {
    height: auto;
    overflow: visible;

    @media (max-width: 1024px) {
      height: auto;
      box-sizing: border-box;
    }
  }

  .terms-titles__slide {
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    padding-block: rem(24px);
    padding-left: rem(20px);
    opacity: 1;
    cursor: pointer;
    text-align: left;

    @media (max-width: 1024px) {
      width: 100%;
      max-width: 100%;
      padding-block: rem(4px);
      padding-left: 0;
      padding-right: rem(8px);
      justify-content: flex-start;
      align-items: flex-start;
      text-align: left;
    }

    :global(.section-title) {
      color: color-mix(in srgb, var(--color-text) 28%, transparent);
      transition: color 0.35s ease;
    }

    &:global(.swiper-slide-active),
    &:global(.is-active) {
      cursor: default;

      :global(.section-title) {
        color: var(--color-text);
      }

      :global(.section-title__mark) {
        opacity: 1;
        border-color: var(--color-text);
      }
    }
  }

  .section-title {
    margin-bottom: 0;

    @media (max-width: 768px) {
      margin-bottom: 0;
    }
  }

  .terms-and-conditions__content :global(.section-title) {
    font-size: clamp(rem(32px), 4vw, rem(72px));
    line-height: 1.05;
    text-align: left;

    @media (max-width: 1024px) {
      font-size: clamp(rem(24px), 5.5vw, rem(40px));
      width: 100%;
    }

    @media (max-width: 768px) {
      font-size: clamp(rem(22px), 6.5vw, rem(32px));
    }

    :global(.section-title__mark) {
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    // Long titles (e.g. Cancellation) must not get clipped by SplitText word boxes.
    :global(.word) {
      overflow: visible;
    }
  }

  .terms-and-conditions__scroll-wrap {
    position: relative;
    flex: 0 1 44%;
    max-width: 46%;
    min-width: 0;
    margin-left: auto;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 10%,
      #000 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 10%,
      #000 88%,
      transparent 100%
    );

    @media (max-width: 1024px) {
      flex: none;
      max-width: 100%;
      width: 100%;
      margin-left: 0;
    }
  }

  .terms-and-conditions__list {
    max-height: 70vh;
    overflow-y: auto;
    padding: 72px 4px;
    scrollbar-width: none;

    @media (max-width: 1024px) {
      max-height: calc(100dvh - var(--footer-offset, 240px) - rem(280px));
      width: 100%;
      padding: rem(12px) 0 rem(12px);
    }

    @media (max-width: 768px) {
      max-height: calc(100dvh - var(--footer-offset, 280px) - rem(240px));
      padding: rem(8px) 0 rem(8px);
    }

    &::-webkit-scrollbar {
      display: none;
    }

    &[hidden] {
      display: none;
    }
  }

  .terms-and-conditions__list-title {
    margin: rem(28px) 0 rem(14px);
    font-size: clamp(rem(13px), 1vw, rem(16px));
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text);

    &:first-child {
      margin-top: 0;
    }
  }

  .terms-and-conditions__list-subtitle {
    margin: rem(16px) 0 rem(8px);
    font-size: clamp(rem(12px), 0.95vw, rem(15px));
    line-height: 1.4;
    font-weight: 500;
    color: var(--color-text);
  }

  .terms-and-conditions__list-text,
  .terms-and-conditions__list-definition {
    margin: 0 0 rem(12px);
    font-size: clamp(rem(11px), 0.9vw, rem(14px));
    line-height: 1.7;
    font-weight: 300;
    color: var(--color-text);
    opacity: 0.78;
    text-wrap: pretty;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .terms-and-conditions__list-definition {
    padding-left: rem(12px);
    border-left: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);

    strong {
      font-weight: 600;
      opacity: 1;
      color: var(--color-text);
    }
  }

  .terms-and-conditions__list-ul {
    list-style: none;
    padding: 0 0 0 rem(4px);
    margin: 0 0 rem(12px);

    li {
      position: relative;
      margin-bottom: rem(6px);
      padding-left: rem(14px);
      font-size: clamp(rem(11px), 0.9vw, rem(14px));
      line-height: 1.7;
      font-weight: 300;
      color: var(--color-text);
      opacity: 0.78;
      text-wrap: pretty;

      &::before {
        content: '—';
        position: absolute;
        left: 0;
        opacity: 0.45;
      }

      &:last-child {
        margin-bottom: 0;
      }
    }

    &--nested {
      margin-top: rem(-4px);
      margin-bottom: rem(12px);
      padding-left: rem(20px);

      li {
        opacity: 0.7;

        &::before {
          content: '·';
          font-weight: 700;
        }
      }
    }
  }
</style>
