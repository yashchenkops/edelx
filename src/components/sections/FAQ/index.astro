---
import Section from '@/components/layout/Section/index.astro';
import SectionTitle from '@/components/modules/SectionTitle/index.astro';
import SectionSubtitle from '@/components/modules/SectionSubtitle/index.astro';
import faqBook from '@/assets/img/faq-book.webp';

const items = [
  {
    question: 'Does EdelX Have A License And Comply With Regulations?',
    answer:
      "Click 'Sign Up', Confirm Your Email, And Complete A Quick Verification. Once Verified, You Can Exchange Fiat For Crypto Directly On The Platform — In Seconds.",
  },
  {
    question: 'What Does The Account Verification Process Involve?',
    answer:
      'Provide basic personal details, confirm your email, and complete a short identity check. Most users finish verification within a few minutes.',
  },
  {
    question: 'How Are My Funds Protected On The Platform?',
    answer:
      'Funds are held with layered security controls, continuous monitoring, and strict operational safeguards until your transfer is complete.',
  },
  {
    question: 'What Currencies And Cryptocurrencies Are Supported?',
    answer:
      'EdelX supports major fiat currencies and popular cryptocurrencies, with pairs updated regularly as the market expands.',
  },
  {
    question: 'How Can I Reach The Support Team If Something Goes Wrong?',
    answer:
      'Contact support anytime through the in-app help center or email. Our team monitors requests around the clock and responds as quickly as possible.',
  },
  {
    question: 'What Currencies Are Supported?',
    answer:
      'You can exchange a wide range of fiat and crypto assets. The full list is always available in your account exchange panel.',
  },
];

// Same chevron as Hero right half (mirrored direction)
const shapePath =
  'M595.973 0C595.32 5.70682e-08 594.716 0.344247 594.382 0.905378L464.236 219.941C461.569 224.43 456.734 227.181 451.514 227.181H443.799C435.626 227.181 429 233.809 429 241.985V267.015C429 275.191 435.626 281.819 443.799 281.819H451.514C456.734 281.819 461.569 284.57 464.236 289.059L594.381 508.095C594.714 508.656 595.319 509 595.971 509H828.071C828.797 509 829.24 508.202 828.856 507.585L687.945 281.558C686.932 279.932 685.152 278.943 683.236 278.943H505.667C497.493 278.943 490.867 272.314 490.868 264.138L490.868 244.86C490.869 236.684 497.495 230.057 505.668 230.057H683.238C685.153 230.057 686.934 229.068 687.947 227.442L828.859 1.41459C829.242 0.79834 828.799 -6.34854e-08 828.073 0H595.973Z';

const VIEW_X = 429;
const SHAPE_W = 400;
const SHAPE_H = 509;
const SX = 1 / SHAPE_W;
const SY = 1 / SHAPE_H;
const clipTransform = `scale(${SX}, ${SY}) translate(${-VIEW_X}, 0)`;
const shapeIds = ['a', 'b'];
---

<Section class="faq" slide="faq">
  <div class="faq__inner">
    <div class="faq__content">
      <SectionTitle class="faq__title">FAQ</SectionTitle>
      <SectionSubtitle class="faq__subtitle">The main questions you may have for us.</SectionSubtitle>
    </div>

    <div class="faq__accordion">
      <div class="faq__decoration" aria-hidden="true">
        <svg class="faq-shape-defs" width="0" height="0" aria-hidden="true">
          <defs>
            <clipPath id="faqShapeClip" clipPathUnits="objectBoundingBox">
              <path transform={clipTransform} d={shapePath}></path>
            </clipPath>
            <linearGradient id="faq-border" x1={VIEW_X + SHAPE_W / 2} y1="0" x2={VIEW_X + SHAPE_W / 2} y2={SHAPE_H} gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#fff" stop-opacity="0.04" />
              <stop offset="30%" stop-color="#fff" stop-opacity="0.14" />
              <stop offset="65%" stop-color="#fff" stop-opacity="0.38" />
              <stop offset="100%" stop-color="#fff" stop-opacity="0.72" />
            </linearGradient>
            <linearGradient id="faq-edge-highlight" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#fff" stop-opacity="0" />
              <stop offset="18%" stop-color="#fff" stop-opacity="0.42" />
              <stop offset="82%" stop-color="#fff" stop-opacity="0.42" />
              <stop offset="100%" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
            <filter id="faq-glow" x="-8%" y="-8%" width="116%" height="116%" color-interpolation-filters="sRGB">
              <feGaussianBlur in="SourceGraphic" stdDeviation="0.6" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
        </svg>

        {shapeIds.map((id) => (
          <div class="faq-shape" data-shape={id}>
            <div class="faq-shape__glass"></div>
            <svg
              class="faq-shape__svg"
              width={SHAPE_W}
              height={SHAPE_H}
              viewBox={`${VIEW_X} 0 ${SHAPE_W} ${SHAPE_H}`}
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g class="faq-shape__border" filter="url(#faq-glow)">
                <path
                  d={shapePath}
                  fill="none"
                  stroke="url(#faq-border)"
                  stroke-width="0.5"
                  vector-effect="non-scaling-stroke"
                />
              </g>
              <g class="faq-shape__edges" stroke="url(#faq-edge-highlight)" stroke-width="0.9" stroke-linecap="round">
                <line x1="607" y1="0.45" x2="817" y2="0.45" />
                <line x1="515" y1="230.057" x2="674" y2="230.057" />
              </g>
            </svg>
          </div>
        ))}
      </div>

      <div class="faq-accordion" data-faq-accordion>
        {items.map((item, index) => (
          <div
            class:list={['faq-accordion__item', { 'is-open': index === 0 }]}
            style={`--faq-i: ${index}`}
          >
            <button
              class="faq-accordion__trigger"
              type="button"
              id={`faq-trigger-${index}`}
              aria-controls={`faq-panel-${index}`}
              aria-expanded={index === 0 ? 'true' : 'false'}
            >
              {item.question}
            </button>
            <div
              class="faq-accordion__panel"
              id={`faq-panel-${index}`}
              role="region"
              aria-labelledby={`faq-trigger-${index}`}
            >
              <div class="faq-accordion__panel-inner">
                <p class="faq-accordion__answer">{item.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="faq__image">
    <img class="faq__image-float" src={faqBook.src} alt="Book image">
  </div>
</Section>

<script>
  import '@/scripts/faq-accordion.ts'
  import { gsap } from 'gsap'
  import { runWhenAppReady } from '@/scripts/app-ready'

  const slide = document.querySelector<HTMLElement>('[data-slide="faq"]')
  const accordion = document.querySelector<HTMLElement>('[data-faq-accordion]')
  const image = document.querySelector<HTMLElement>('.faq__image')
  const itemCount =
    accordion?.querySelectorAll('.faq-accordion__item').length ?? 0
  // delay(0.06 + i*0.07) + duration(0.65), converted to ms
  const INTRO_MS = Math.ceil((0.06 + Math.max(itemCount - 1, 0) * 0.07 + 0.65) * 1000) + 40

  let revealTimer = 0

  const lockItemsVisible = () => {
    if (!accordion) return
    // Lock first, then drop animation class — never leave opacity:0 stuck.
    accordion.classList.add('is-revealed')
    accordion.classList.remove('is-items-in')
  }

  const showItems = (instant = false) => {
    if (!accordion) return
    window.clearTimeout(revealTimer)

    if (instant) {
      lockItemsVisible()
      return
    }

    accordion.classList.remove('is-revealed', 'is-items-in')
    // Restart CSS animation reliably
    void accordion.offsetWidth
    accordion.classList.add('is-items-in')
    revealTimer = window.setTimeout(lockItemsVisible, INTRO_MS)
  }

  const hideItems = () => {
    window.clearTimeout(revealTimer)
    accordion?.classList.remove('is-items-in', 'is-revealed')
  }

  type ShapeBundle = {
    glass: HTMLElement | null
    svg: HTMLElement | null
    path: SVGPathElement | null
    pathLength: number
    edges: SVGLineElement[]
  }

  const shapeBundles: ShapeBundle[] = Array.from(
    document.querySelectorAll<HTMLElement>('.faq-shape'),
  ).map((shape) => {
    const path = shape.querySelector<SVGPathElement>('.faq-shape__border path')
    let pathLength = 0
    try {
      pathLength = path?.getTotalLength() ?? 0
    } catch {
      pathLength = 0
    }

    return {
      glass: shape.querySelector<HTMLElement>('.faq-shape__glass'),
      svg: shape.querySelector<HTMLElement>('.faq-shape__svg'),
      path,
      pathLength,
      edges: Array.from(shape.querySelectorAll<SVGLineElement>('.faq-shape__edges line')),
    }
  })

  if (slide) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let played = false
    let isActive = slide.classList.contains('swiper-slide-active')

    hideItems()

    if (image) {
      gsap.set(image, {
        opacity: 0,
        x: 36,
        scale: 0.94,
        filter: 'blur(10px)',
      })
    }

    shapeBundles.forEach(({ glass, svg, path, pathLength, edges }) => {
      if (glass) gsap.set(glass, { opacity: 0, scale: 0.965 })
      if (svg) gsap.set(svg, { opacity: 0 })
      if (path && pathLength) {
        gsap.set(path, {
          strokeDasharray: pathLength,
          strokeDashoffset: pathLength,
          opacity: 0.35,
        })
      }
      if (edges.length) {
        gsap.set(edges, { opacity: 0, scaleX: 0.72, transformOrigin: '50% 50%' })
      }
    })

    const playShapeIn = () => {
      shapeBundles.forEach(({ glass, svg, path, pathLength, edges }, index) => {
        const delay = 0.08 + index * 0.12

        if (reduced) {
          if (glass) gsap.to(glass, { opacity: 1, scale: 1, duration: 0.25, overwrite: 'auto' })
          if (svg) gsap.to(svg, { opacity: 1, duration: 0.25, overwrite: 'auto' })
          if (path) gsap.set(path, { strokeDashoffset: 0, opacity: 1 })
          if (edges.length) gsap.set(edges, { opacity: 1, scaleX: 1 })
          return
        }

        if (glass) {
          gsap.fromTo(
            glass,
            { opacity: 0, scale: 0.965 },
            {
              opacity: 1,
              scale: 1,
              duration: 1.05,
              delay,
              ease: 'power3.out',
              overwrite: 'auto',
            },
          )
        }

        if (svg) {
          gsap.fromTo(
            svg,
            { opacity: 0 },
            {
              opacity: 1,
              duration: 0.55,
              delay: delay + 0.04,
              ease: 'power2.out',
              overwrite: 'auto',
            },
          )
        }

        if (path && pathLength) {
          gsap.fromTo(
            path,
            { strokeDashoffset: pathLength, opacity: 0.25 },
            {
              strokeDashoffset: 0,
              opacity: 1,
              duration: 1.15,
              delay: delay + 0.06,
              ease: 'power2.out',
              overwrite: true,
            },
          )
        }

        if (edges.length) {
          gsap.fromTo(
            edges,
            { opacity: 0, scaleX: 0.72 },
            {
              opacity: 1,
              scaleX: 1,
              duration: 0.7,
              delay: delay + 0.45,
              stagger: 0.06,
              ease: 'power2.out',
              overwrite: true,
            },
          )
        }
      })
    }

    const playShapeOut = () => {
      shapeBundles.forEach(({ glass, svg, path, pathLength, edges }) => {
        if (glass) {
          gsap.to(glass, {
            opacity: 0,
            scale: 0.98,
            duration: reduced ? 0.2 : 0.28,
            ease: 'power2.in',
            overwrite: 'auto',
          })
        }

        if (svg) {
          gsap.to(svg, {
            opacity: 0,
            duration: reduced ? 0.2 : 0.28,
            ease: 'power2.in',
            overwrite: 'auto',
          })
        }

        if (path && pathLength) {
          gsap.to(path, {
            strokeDashoffset: pathLength * 0.12,
            opacity: 0,
            duration: reduced ? 0.2 : 0.28,
            ease: 'power2.in',
            overwrite: true,
          })
        }

        if (edges.length) {
          gsap.to(edges, {
            opacity: 0,
            duration: reduced ? 0.15 : 0.22,
            ease: 'power2.in',
            overwrite: true,
          })
        }
      })
    }

    const playIn = () => {
      runWhenAppReady(() => {
        if (!slide.classList.contains('swiper-slide-active')) return

        playShapeIn()

        if (reduced) {
          showItems(true)
          if (image) {
            gsap.to(image, {
              opacity: 1,
              x: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.25,
              overwrite: true,
            })
          }
          played = true
          return
        }

        showItems()

        if (image) {
          gsap.fromTo(
            image,
            {
              opacity: 0,
              x: 36,
              scale: 0.94,
              filter: 'blur(10px)',
            },
            {
              opacity: 1,
              x: 0,
              scale: 1,
              filter: 'blur(0px)',
              duration: 0.85,
              delay: 0.1,
              ease: 'power3.out',
              overwrite: true,
            },
          )
        }

        played = true
      })
    }

    const playOut = () => {
      if (!played) return
      playShapeOut()
      hideItems()

      if (image) {
        gsap.to(image, {
          opacity: 0,
          x: 20,
          scale: 0.97,
          filter: 'blur(6px)',
          duration: reduced ? 0.2 : 0.28,
          ease: 'power2.in',
          overwrite: true,
        })
      }
    }

    // ── Mouse parallax on shape wrappers (not glass/svg — avoids kill by entrance overwrite)
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    const desktopMq = window.matchMedia('(min-width: 1024px)')
    const shapeEls = Array.from(document.querySelectorAll<HTMLElement>('.faq-shape'))
    const shapeGroups = shapeEls.map((el, index) => ({
      el,
      max: index === 0 ? 14 : 18,
    }))

    const parallaxEnabled = () =>
      !reduced && finePointer.matches && desktopMq.matches && shapeGroups.length > 0

    const parallaxTweens = shapeGroups.map((group) => ({
      max: group.max,
      xTo: gsap.quickTo(group.el, 'x', { duration: 0.7, ease: 'power3.out' }),
      yTo: gsap.quickTo(group.el, 'y', { duration: 0.7, ease: 'power3.out' }),
    }))

    const resetParallax = () => {
      parallaxTweens.forEach(({ xTo, yTo }) => {
        xTo(0)
        yTo(0)
      })
    }

    const onPointerMove = (event: PointerEvent) => {
      if (!parallaxEnabled() || !isActive) return

      const rect = slide.getBoundingClientRect()
      if (!rect.width || !rect.height) return

      const nx = ((event.clientX - rect.left) / rect.width - 0.5) * 2
      const ny = ((event.clientY - rect.top) / rect.height - 0.5) * 2
      const clampedX = Math.max(-1, Math.min(1, nx))
      const clampedY = Math.max(-1, Math.min(1, ny))

      parallaxTweens.forEach(({ max, xTo, yTo }) => {
        xTo(clampedX * max)
        yTo(clampedY * max)
      })
    }

    if (parallaxTweens.length && !reduced) {
      // Listen on window so Swiper transforms / overlays don't drop move events.
      window.addEventListener('pointermove', onPointerMove, { passive: true })
      slide.addEventListener('pointerleave', resetParallax)
      desktopMq.addEventListener('change', () => {
        if (!desktopMq.matches) resetParallax()
      })
      finePointer.addEventListener('change', () => {
        if (!finePointer.matches) resetParallax()
      })
    }

    const sync = () => {
      const nextActive = slide.classList.contains('swiper-slide-active')
      if (nextActive === isActive) return
      isActive = nextActive
      if (nextActive) playIn()
      else {
        playOut()
        resetParallax()
      }
    }

    new MutationObserver(sync).observe(slide, {
      attributes: true,
      attributeFilter: ['class'],
    })

    if (isActive) playIn()
  }
</script>

<style lang="scss">
  .faq__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(rem(50px), 4vw, rem(80px));
  }

  .faq__content {
    flex: 0 1 500px;
    max-width: 500px;
    min-width: 0;
  }

  .faq__title {
    margin-bottom: clamp(rem(12px), 1vh, rem(30px));
  }

  .faq__accordion {
    position: relative;
    flex: 1 1 560px;
    max-width: 720px;
    min-width: 0;
    container-type: inline-size;
  }

  .faq__decoration {
    position: absolute;
    top: 0;
    bottom: 0;
    right: -8%;
    z-index: 0;
    display: flex;
    align-items: center;
    gap: clamp(rem(8px), 1.2vw, rem(20px));
    pointer-events: none;
  }

  .faq-shape-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .faq-shape {
    position: relative;
    width: min(480px, 68cqw);
    aspect-ratio: 400 / 509;
    flex-shrink: 0;
    will-change: transform;

    & + & {
      margin-left: clamp(rem(-120px), -10cqw, rem(-60px));
    }
  }

  .faq-shape__glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: url(#faqShapeClip);
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;

    :global([data-theme='light']) & {
      background: rgb(0 0 0 / 10%);
    }
  }

  .faq-shape__svg {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
  }

  .faq-accordion {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(rem(22px), 3vw, rem(40px));
  }

  .faq-accordion__item {
    position: relative;
    z-index: 1;
    min-width: 0;
    // Opacity only on the item — filter/transform here break 0fr/1fr panels.
    opacity: 0;
  }

  .faq-accordion__trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(rem(16px), 1.7vw, rem(28px));
    line-height: 1.25;
    color: var(--color-text);
    transform: translateY(28px);
    filter: blur(6px);
    transition: opacity v.$transition-base;

    @include m.hover {
      opacity: 0.75;
    }
  }

  .faq-accordion.is-items-in .faq-accordion__item {
    animation: faq-item-fade 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.06s + var(--faq-i, 0) * 0.07s);
  }

  .faq-accordion.is-items-in .faq-accordion__trigger {
    animation: faq-trigger-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.06s + var(--faq-i, 0) * 0.07s);
  }

  @keyframes faq-item-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes faq-trigger-in {
    to {
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Hard lock after intro — questions cannot stay stuck invisible */
  .faq-accordion.is-revealed .faq-accordion__item {
    opacity: 1;
    animation: none;
  }

  .faq-accordion.is-revealed .faq-accordion__trigger {
    transform: none;
    filter: none;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-accordion__item {
      opacity: 1;
      animation: none !important;
    }

    .faq-accordion__trigger {
      transform: none;
      filter: none;
      animation: none !important;
    }
  }

  /* Height animated via GSAP — works inside Swiper transforms */
  .faq-accordion__panel {
    display: block;
    overflow: hidden;
    height: 0;
    opacity: 0;
    will-change: height, opacity;
  }

  .faq-accordion__panel-inner {
    overflow: hidden;
  }

  .faq-accordion__answer {
    margin: clamp(rem(10px), 1.2vw, rem(16px)) 0 0;
    max-width: 42em;
    font-weight: 400;
    font-size: clamp(rem(13px), 1.2vw, rem(20px));
    line-height: 1.4;
    color: var(--color-text);
    opacity: 0.85;
    text-wrap: pretty;
  }

  .faq__image {
    position: absolute;
    top: 50%;
    right: -9%;
    z-index: 1;
    translate: 0 -50%;
    max-width: min(325px, 22vw);
    pointer-events: none;
    opacity: 0;
  }

  .faq__image-float {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
    animation: faq-float 8.5s ease-in-out infinite;
  }

  @keyframes faq-float {
    0%   { transform: translate(0px, 0px) rotate(0deg); }
    25%  { transform: translate(5px, -10px) rotate(1deg); }
    50%  { transform: translate(-4px, -18px) rotate(-0.7deg); }
    75%  { transform: translate(-7px, -8px) rotate(0.6deg); }
    100% { transform: translate(0px, 0px) rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__image-float {
      animation: none !important;
    }
  }

  @media (max-width: 1024px) {
    .faq__inner {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .faq__content {
      flex: 1 1 100%;
      max-width: none;
    }

    .faq__accordion {
      flex: 1 1 100%;
      max-width: none;
    }

    .faq__decoration {
      right: 0;
    }

    .faq-shape__glass {
      background: rgb(255 255 255 / 8%);

      :global([data-theme='light']) & {
        background: rgb(0 0 0 / 8%);
      }
    }

    .faq-shape {
      width: min(360px, 52vw);
    }

    .faq__image {
      right: -4%;
      max-width: min(240px, 28vw);
      opacity: 0.9;
    }
  }
</style>
