---
import PageHeader from '@/components/layout/PageHeader/index.astro';
import ThemeToggle from '@/components/modules/ThemeToggle/index.astro';
import BurgerMenu from '@/components/modules/BurgerMenu/index.astro';
import logoDark from '@/assets/img/logo.webp';
import logoLight from '@/assets/img/light/logo.webp';
---

<PageHeader>
  <a href={import.meta.env.BASE_URL} class="logo" data-header-item>
    <img class="logo__img logo__img--dark" src={logoDark.src} alt="logo">
    <img class="logo__img logo__img--light" src={logoLight.src} alt="logo">
  </a>
  <div class="header__center" data-header-item>
    <ThemeToggle />
  </div>
  <div class="header__desktop" data-header-item>
    <div class="actions">
      <a href="#" class="actions__login">Log In</a>
      <a href="#" class="actions__signup">Sign Up</a>
    </div>
  </div>
  <div data-header-burger>
    <BurgerMenu />
  </div>
</PageHeader>

<script>
  import { gsap } from 'gsap'
  import { runWhenAppReady } from '@/scripts/app-ready'

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-header-item]'))
  const burger = document.querySelector<HTMLElement>('[data-burger]')
  const animTargets = [...items, ...(burger ? [burger] : [])]

  if (animTargets.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const centered = items.filter((el) => el.classList.contains('header__center'))
    const moving = animTargets.filter((el) => !el.classList.contains('header__center'))

    if (moving.length) gsap.set(moving, { opacity: 0, y: -14 })
    if (centered.length) gsap.set(centered, { opacity: 0 })

    runWhenAppReady(() => {
      if (reduced) {
        gsap.to(animTargets, { opacity: 1, y: 0, duration: 0.2, overwrite: true })
        return
      }

      if (moving.length) {
        gsap.fromTo(
          moving,
          { opacity: 0, y: -16 },
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
            delay: 0.02,
            stagger: 0.07,
            ease: 'power3.out',
            overwrite: true,
          },
        )
      }

      if (centered.length) {
        gsap.fromTo(
          centered,
          { opacity: 0 },
          {
            opacity: 1,
            duration: 0.5,
            delay: 0.12,
            ease: 'power2.out',
            overwrite: true,
          },
        )
      }
    })
  }
</script>

<style lang="scss">
  .logo {
    position: relative;
    z-index: calc(v.$z-header + 20);
    opacity: 0;
  }

  .logo__img {
    display: block;
    max-width: #{rem(200px)};

    @media (max-width: 768px) {
      max-width: #{rem(140px)};
    }

    &--light {
      display: none;
    }
  }

  .header__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;

    @media (max-width: 1024px) {
      display: none;
    }
  }

  .header__desktop {
    display: flex;
    align-items: center;
    gap: #{rem(24px)};
    opacity: 0;

    @media (max-width: 1024px) {
      display: none;
    }
  }

  [data-header-burger] {
    @media (min-width: 1025px) {
      display: none;
    }
  }

  .actions {
    display: flex;
    align-items: center;
    gap: #{rem(18px)};
    color: var(--color-text);

    a {
      transition: opacity v.$transition-base, transform v.$transition-base;

      @include m.hover {
        transform: scale(1.05)
      }
    }

    &__signup {
      opacity: 0.5;
      order: 2;
    }

    &::before {
      content: '';
      display: block;
      width: 2px;
      height: 28px;
      background-color: v.$blue;
      order: 1;
    }
  }

  :global([data-theme='light']) {
    .logo__img--dark {
      display: none;
    }

    .logo__img--light {
      display: block;
    }
  }
</style>
