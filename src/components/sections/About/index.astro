<style lang="scss">
  .about__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .about__content {
    max-width: 666px;
    flex-shrink: 1;
  }

  .about__content-title {
    margin-bottom: 30px;
  }

  .about__content-subtitle {
    margin-bottom: 30px;
  }

  .about__content-socials {
    display: flex;
    align-items: center;
    gap: 42px;
    
    &-item {
      color: var(--color-text);
      transition: opacity v.$transition-base, transform v.$transition-base, color v.$transition-base;

      @include m.hover {
        transform: scale(1.05)
      }
    }
  }

  .about__illustration {
    display: flex;
    align-items: center;
    flex-shrink: 0.5;
    gap: 18px;

    .item-1 {
      margin-right: -48px;
    }

    .item-4 {
      margin-left: -48px;
    }
  }

  :global(.about__illustration-item svg path) {
    fill: var(--color-text);
  }

</style>
